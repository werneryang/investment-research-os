        "id": "cash-basis",
        "document": "q3",
        "title": {
          "zh": "现金差额非发行人 FCF",
          "en": "Cash difference is not issuer-defined FCF"
        },
        "fact": {
          "zh": "同批四份 SEC 文件未找到 free cash flow 定义；仅计算 CFO 减现金 PPE 净支出。",
          "en": "No free-cash-flow definition was found in these four SEC filings; only CFO less net cash PPE is calculated."
        },
        "limit": {
          "zh": "不含融资租赁新增、并购或 SpaceX 股权投资；不等于 owner cash。",
          "en": "Excludes new finance leases, acquisitions and SpaceX equity investment; not owner cash."
        }
      },
      {
        "id": "guidance-floor",
        "document": "q3",
        "title": {
          "zh": "年度资本开支展望",
          "en": "Annual capex outlook"
        },
        "fact": {
          "zh": "Q3 10-Q 预期 2026 资本开支超过 200 亿美元；9M 现金 PPE 为 13,014 百万美元。",
          "en": "Q3 10-Q expects 2026 capex in excess of USD20bn; nine-month cash PPE was USD13,014m."
        },
        "limit": {
          "zh": "年度尚未结束；这是大于式门槛，不是点值或已实现收入。",
          "en": "The year is incomplete; this is a strict floor, not a point estimate or realized revenue."
        },
        "excerpts": [
          "We currently expect our capital expenditures to be in excess of $20 billion in 2026"
        ]
      },
